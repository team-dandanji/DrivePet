# 복사해서 .env로 쓴다 (.env는 커밋하지 않음). 값은 직접 넣는다.
# 프로필: local-fake(기본, 외부 키 없이) / local-live(실제 카카오·공공데이터)
SPRING_PROFILES_ACTIVE=local-fake

# JWT 서명 키(32바이트 이상 무작위). local-live에서는 반드시 주석을 풀고 넣는다
# (local-fake에서는 비워 두면 개발용 기본 키를 쓴다. 빈 값으로 두면 시작하지 않으니 주석 상태로 둔다)
# 생성 예: openssl rand -base64 48
# DRIVEPET_JWT_SECRET=

# 폰에서 접속되는 서버 주소(HTTPS 터널). 카카오 Redirect URI = 이 주소 + /api/v1/auth/kakao/callback
DRIVEPET_PUBLIC_BASE_URL=http://localhost:8080

# 카카오 개발자 앱 (local-live)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 공공데이터포털 일반 인증키(Decoding) — 기상청 단기예보·특보, 에어코리아 대기오염·측정소정보 공통 (local-live)
DATA_GO_KR_SERVICE_KEY=

DB_PASSWORD=drivepet
