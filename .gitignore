*.iml
.gradle/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/
*.aab
# 개발용 APK는 올리지 않고, 제출용 release APK만 apk/ 폴더에 둡니다
*.apk
!apk/*.apk

# 비밀값 (server/.gitignore에도 있지만 어느 폴더든 막는다)
.env
.env.*
!.env.example

# 개인 개발 도구 설정·산출물 (팀 저장소에 올리지 않음)
# 맨 위 폴더의 숨김 폴더는 모두 개인 설정으로 보고 올리지 않는다
/.*/
.kotlin/
.vscode/
*.log

# 개발 과정 문서 (내 컴퓨터에만 둔다)
docs/plans/
docs/api/notion-drafts/
docs/archive/
docs/api/
docs/implementation/
spikes/
